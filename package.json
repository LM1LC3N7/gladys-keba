{
  "name": "gladys-keba",
  "version": "0.1.0",
  "private": true,
  "description": "Gladys Assistant external integration for KEBA KeContact P20 / P30 charging stations (state, plug and cable, power, current and voltage per phase, energy, current limit; optional allow/forbid charging and charging current), over their local UDP interface. Unofficial, not affiliated with KEBA.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
